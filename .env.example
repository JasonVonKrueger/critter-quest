# Server environment (export in your shell before npm run dev)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Client override, normally unnecessary with Vite's proxy:
# VITE_SERVER_URL=http://localhost:3001
# Server save location (relative to server/ when using npm run dev)
# DATABASE_FILE=data/games.sqlite
# Optional one-time import of an existing JSON save (source is preserved):
# LEGACY_DATA_FILE=data/games.json
